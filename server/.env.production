# Production Environment Variables for Railway
NODE_ENV=production
PORT=3000

# Database (Railway will provide this automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/elitetena

# JWT Secret (generate a strong secret)
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this

# Chapa Payment (Test keys for now)
CHAPA_SECRET_KEY=CHASECK_TEST-your-test-secret-key
CHAPA_PUBLIC_KEY=CHASECK_TEST-your-test-public-key
CHAPA_WEBHOOK_SECRET=your-webhook-secret

# CORS Origins (will be updated with actual Vercel URL)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5174

# Session Secret
SESSION_SECRET=your-session-secret-key-change-this

# Redis (Railway addon)
REDIS_URL=redis://localhost:6379

# File Upload (use Railway's file system for now)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Blockchain
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your-infura-key
PRIVATE_KEY=your-ethereum-private-key

# Admin Credentials
ADMIN_EMAIL=admin@elitetena.com
ADMIN_PASSWORD=admin123